{
  "name": "mcp-leclerc-drive",
  "version": "1.0.0",
  "mcpName": "io.github.maurice30120/leclerc-drive",
  "description": "Expose your Leclerc Drive as MCP tools via WebMCP — search products, manage cart, refresh natively, from any MCP client (opencode / Claude Code).",
  "type": "module",
  "files": [
    "dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc && npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspaces --if-present",
    "build:extension": "node scripts/build-extension.mjs",
    "build:all": "npm run build && npm run build:extension",
    "fetch:model": "node scripts/fetch-model.mjs",
    "dev": "tsc --watch",
    "harness:campaign": "npm run campaign --workspace @leclerc/harness",
    "harness:campaign:jsonl": "npm run campaign --workspace @leclerc/harness -- --jsonl",
    "test:harness:local": "npm run campaign:webgpu --workspace @leclerc/harness",
    "mobile:start": "npm --prefix drive-assistant-mobile start",
    "mobile:ios": "npm --prefix drive-assistant-mobile run ios --",
    "mobile:android": "npm --prefix drive-assistant-mobile run android --",
    "mobile:typecheck": "npm --prefix drive-assistant-mobile typecheck",
    "mobile:test": "npm --prefix drive-assistant-mobile test",
    "test": "node --test tests/*.test.ts && npm run test --workspaces --if-present",
    "test:legacy": "node --test tests/*.test.ts",
    "test:packages": "npm run test --workspaces --if-present",
    "test:inference": "MCP_LECLERC_RUN_INFERENCE=1 node --test tests/model-inference.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extension.json && npm run typecheck --workspaces --if-present",
    "clean": "node scripts/clean.mjs --keep-models",
    "clean:dry": "node scripts/clean.mjs --dry-run",
    "clean:all": "node scripts/clean.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webmcp",
    "mcp-b",
    "opencode",
    "leclerc",
    "leclerc-drive",
    "grocery",
    "courses"
  ],
  "author": "maurice30120",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurice30120/mcp-leclerc-drive.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mcp-b/global": "^6.0.3"
  },
  "devDependencies": {
    "@mcp-b/webmcp-local-relay": "^6.0.3",
    "@types/chrome": "^0.2.2",
    "@types/node": "^22.0.0",
    "cli-progress": "^3.12.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "webmcp-types": "^0.1.10"
  }
}
